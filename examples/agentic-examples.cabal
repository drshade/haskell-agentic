cabal-version:      3.0
name:               agentic-examples
version:            0.2.1.0
synopsis:           The examples from the haskell-agentic README
description:
  Runnable examples for the agentic packages: the dino project, tic-tac-toe,
  a review with Jev, email approval across restarts, and the kitchen sink.
  Not published to Hackage.
license:            BSD-2-Clause
author:             Tom Wells
maintainer:         drshade@gmail.com
copyright:          2026 Tom Wells
category:           AI
build-type:         Simple
extra-source-files: diagrams/*.mmd diagrams/*.dot diagrams/*.tree diagrams/README.md
tested-with:        GHC ==9.6.7 || ==9.8.4 || ==9.10.3 || ==9.12.2 || ==9.14.1

executable dino
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:      -Wall -main-is Dino
  hs-source-dirs:   .
  main-is:          Dino.hs
  build-depends:
    , agentic           ==0.2.*
    , agentic-anthropic ==0.2.*
    , agentic-io        ==0.2.*
    , agentic-jev       ==0.2.*
    , base              >=4.18 && <5
    , text              >=2.0 && <2.2
executable review
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:      -Wall -main-is Review
  hs-source-dirs:   .
  main-is:          Review.hs
  build-depends:
    , agentic           ==0.2.*
    , agentic-io        ==0.2.*
    , agentic-jev       ==0.2.*
    , base              >=4.18 && <5
    , text              >=2.0 && <2.2
executable tictactoe
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:      -Wall -main-is TicTacToe
  hs-source-dirs:   .
  main-is:          TicTacToe.hs
  build-depends:
    , agentic           ==0.2.*
    , agentic-openai    ==0.2.*
    , agentic-io        ==0.2.*
    , base              >=4.18 && <5
    , text              >=2.0 && <2.2
executable kitchensink
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:      -Wall -main-is KitchenSink
  hs-source-dirs:   .
  main-is:          KitchenSink.hs
  build-depends:
    , agentic           ==0.2.*
    , agentic-anthropic ==0.2.*
    , agentic-io        ==0.2.*
    , agentic-jev       ==0.2.*
    , base              >=4.18 && <5
    , text              >=2.0 && <2.2

-- Scripted dino behavior and pure graph projection; no provider calls.
test-suite diagram-test
  type:             exitcode-stdio-1.0
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DerivingVia
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:      -Wall
  hs-source-dirs:   .
  main-is:          DiagramSpec.hs
  other-modules:    KitchenSink Dino TicTacToe Review DinoSpec EmailApproval
  build-depends:
    , agentic           ==0.2.*
    , agentic-openai    ==0.2.*
    , agentic-anthropic ==0.2.*
    , agentic-io        ==0.2.*
    , agentic-jev       ==0.2.*
    , agentic-aeson     ==0.2.*
    , aeson             >=2.1 && <2.3
    , bytestring        >=0.11 && <0.13
    , directory         >=1.3 && <1.4
    , filepath          >=1.4 && <1.6
    , base              >=4.18 && <5
    , text              >=2.0 && <2.2

executable email-approval
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass DuplicateRecordFields LambdaCase NoFieldSelectors
    OverloadedRecordDot OverloadedStrings
  ghc-options:      -Wall -main-is EmailApproval
  hs-source-dirs:   .
  main-is:          EmailApproval.hs
  build-depends:
    , agentic           ==0.2.*
    , agentic-anthropic ==0.2.*
    , agentic-io        ==0.2.*
    , agentic-aeson     ==0.2.*
    , aeson             >=2.1 && <2.3
    , bytestring        >=0.11 && <0.13
    , directory         >=1.3 && <1.4
    , filepath          >=1.4 && <1.6
    , base              >=4.18 && <5
    , text              >=2.0 && <2.2

test-suite email-approval-test
  type:             exitcode-stdio-1.0
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass DuplicateRecordFields LambdaCase NoFieldSelectors
    OverloadedRecordDot OverloadedStrings
  ghc-options:      -Wall
  hs-source-dirs:   .
  main-is:          EmailApprovalSpec.hs
  other-modules:    EmailApproval
  build-tool-depends: agentic-examples:email-approval
  build-depends:
    , agentic           ==0.2.*
    , agentic-anthropic ==0.2.*
    , agentic-io        ==0.2.*
    , agentic-aeson     ==0.2.*
    , aeson             >=2.1 && <2.3
    , bytestring        >=0.11 && <0.13
    , directory         >=1.3 && <1.4
    , filepath          >=1.4 && <1.6
    , process           >=1.6 && <1.7
    , base              >=4.18 && <5
    , text              >=2.0 && <2.2
