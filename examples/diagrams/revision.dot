digraph flow {
  compound=true;
  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  input [label="input", shape=oval];
  subgraph cluster_n_flow_0 {
    label="repeatUntil";
    style=rounded;
    n_flow_1 [label="Done?", shape=diamond, style=solid];
    subgraph cluster_n_flow_repeat_test_0 {
      label="Funny enough?";
      style=rounded;
      n_flow_repeat_test_note_seq_0_0 [label="judge\nyes/no \"Would a 10-year-old laugh at this joke?\""];
    }
    n_flow_repeat_note_0 [label="draft @Joke\nRevise joke\n\"Improve this joke for a 10-year-old.\""];
  }
  output [label="output", shape=oval];
  n_flow_repeat_test_note_seq_0_0 -> n_flow_1;
  input -> n_flow_repeat_test_note_seq_0_0;
  n_flow_1 -> n_flow_repeat_note_0 [label="continue"];
  n_flow_repeat_note_0 -> n_flow_repeat_test_note_seq_0_0 [label="again", style=dashed];
  n_flow_1 -> output [label="done"];
}
