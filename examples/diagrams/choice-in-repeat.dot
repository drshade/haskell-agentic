digraph flow {
  compound=true;
  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  input [label="input", shape=oval];
  subgraph cluster_n_flow_0 {
    label="repeatUntil";
    style=rounded;
    n_flow_repeat_seq_1_0 [label="", shape=diamond, style=solid, width=0.3, height=0.3, fixedsize=true];
    entry_flow_repeat_seq_1_select_1 [label="", shape=point, width=0.06];
    n_flow_repeat_seq_1_choose_0_0 [label="arr"];
  }
  output [label="output", shape=oval];
  input -> n_flow_repeat_seq_1_0;
  n_flow_repeat_seq_1_0 -> n_flow_repeat_seq_1_choose_0_0 [label="left"];
  n_flow_repeat_seq_1_choose_0_0 -> n_flow_repeat_seq_1_0 [label="again", style=dashed];
  n_flow_repeat_seq_1_0 -> entry_flow_repeat_seq_1_select_1 [label="right"];
  entry_flow_repeat_seq_1_select_1 -> n_flow_repeat_seq_1_0 [label="again", style=dashed];
  input -> output;
  n_flow_repeat_seq_1_choose_0_0 -> output;
  entry_flow_repeat_seq_1_select_1 -> output;
}
