digraph flow {
  compound=true;
  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  input [label="input", shape=oval];
  subgraph cluster_n_flow_0 {
    label="repeatUntil";
    style=rounded;
    n_flow_1 [label="Done?", shape=diamond, style=solid];
    n_flow_repeat_seq_0_fan_0_0 [label="act"];
    n_flow_repeat_seq_0_fan_1_0 [label="act"];
  }
  output [label="output", shape=oval];
  input -> n_flow_1;
  n_flow_1 -> n_flow_repeat_seq_0_fan_0_0 [label="continue"];
  n_flow_1 -> n_flow_repeat_seq_0_fan_1_0 [label="continue"];
  n_flow_repeat_seq_0_fan_0_0 -> n_flow_1 [label="again", style=dashed];
  n_flow_repeat_seq_0_fan_1_0 -> n_flow_1 [label="again", style=dashed];
  n_flow_1 -> output [label="done"];
}
