digraph flow {
  compound=true;
  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  input [label="input", shape=oval];
  n_flow_0 [label="", shape=diamond, style=solid, width=0.3, height=0.3, fixedsize=true];
  subgraph cluster_n_flow_choose_0_0 {
    label="repeatUntil";
    style=rounded;
    n_flow_choose_0_1 [label="Done?", shape=diamond, style=solid];
    n_flow_choose_0_repeat_0 [label="act"];
  }
  output [label="output", shape=oval];
  input -> n_flow_0;
  n_flow_0 -> n_flow_choose_0_1 [label="left"];
  n_flow_choose_0_1 -> n_flow_choose_0_repeat_0 [label="continue"];
  n_flow_choose_0_repeat_0 -> n_flow_choose_0_1 [label="again", style=dashed];
  n_flow_choose_0_1 -> output [label="done"];
  n_flow_0 -> output [label="right"];
}
