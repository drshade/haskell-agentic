digraph flow {
  compound=true;
  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  input [label="input", shape=oval];
  n_flow_seq_0_0 [label="", shape=diamond, style=solid, width=0.3, height=0.3, fixedsize=true];
  entry_flow_seq_0_select_0 [label="", shape=point, width=0.06];
  n_flow_seq_1_fan_0_note_0 [label="act\nf"];
