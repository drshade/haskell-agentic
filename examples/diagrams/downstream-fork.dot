  output [label="output", shape=oval];
  input -> n_flow_seq_0_0;
  n_flow_seq_0_0 -> entry_flow_seq_0_select_0 [label="left", tailport=sw, headport=w, minlen=2];
  entry_flow_seq_0_select_0 -> n_flow_seq_1_fan_0_note_0;
  n_flow_seq_0_0 -> entry_flow_seq_0_select_0 [label="right", tailport=se, headport=e, minlen=2];
  entry_flow_seq_0_select_0 -> n_flow_seq_1_fan_1_note_0;
  n_flow_seq_1_fan_0_note_0 -> output;
  n_flow_seq_1_fan_1_note_0 -> output;
}
