digraph flow {
  compound=true;
  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica"];
  input [label="input", shape=oval];
  n_flow_0 [label="", shape=diamond, style=solid, width=0.3, height=0.3, fixedsize=true];
  n_flow_choose_0_0 [label="", shape=diamond, style=solid, width=0.3, height=0.3, fixedsize=true];
  n_flow_choose_0_choose_1_note_0 [label="act\ninner"];
  output [label="output", shape=oval];
  input -> n_flow_0;
  n_flow_0 -> n_flow_choose_0_0 [label="left"];
  n_flow_choose_0_0 -> n_flow_choose_0_choose_1_note_0 [label="right"];
  n_flow_choose_0_0 -> output [label="left"];
  n_flow_choose_0_choose_1_note_0 -> output;
  n_flow_0 -> output [label="right"];
}
